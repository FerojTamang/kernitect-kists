{
  "name": "@kists/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.check.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "db:check": "tsx src/utils/check-database.ts",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:seed": "tsx src/database/cli.ts seed",
    "db:reset": "tsx src/database/cli.ts reset",
    "test:db": "tsx --test test/database*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6"
  }
}
